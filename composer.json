{
  "name": "nhanaz/simplesql",
  "type": "library",
  "description": "Hybrid SQL-YAML data management library for PocketMine-MP. Combines SQL performance with YAML user-friendliness.",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "pocketmine/pocketmine-mp": "^5.0.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "5.49.1",
    "phpstan/phpstan": "^2.3"
  },
  "autoload": {
    "classmap": [
      "src"
    ]
  },
  "config": {
    "allow-plugins": false,
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/axolotl-pm/PocketMine-MP",
      "no-api": true
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "phpstan": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress"
  },
  "extra": {
    "virion": {
      "spec": "3.0",
      "namespace-root": "NhanAZ\\SimpleSQL"
    }
  }
}
